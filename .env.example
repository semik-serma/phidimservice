# ==========================================
# PHIDIM SERVICE - ENVIRONMENT CONFIGURATION
# ==========================================

# Google OAuth Credentials
# Obtain these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Full callback URL. MUST match EXACTLY one of the "Authorized redirect URIs"
# registered in Google Cloud Console for this OAuth Client.
# Dev example: http://localhost:3000/api/auth/google/callback
# Prod example: https://yourdomain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# NextAuth Configuration
NEXTAUTH_SECRET=your_random_nextauth_secret_32_chars_or_more
NEXTAUTH_URL=http://localhost:3000

# ==========================================
# RBAC / JWT SESSION SECURITY  (REQUIRED in production)
# ==========================================
# Used to sign the short-lived access token (HS256). MUST be a long,
# random string (>=32 chars). Keep it secret — it is validated by both
# the API layer and the edge middleware.
JWT_SECRET=generate_a_long_random_secret_here

# Refresh-token signing secret.
REFRESH_TOKEN_SECRET=another_long_random_secret_here

# Access token lifetime (default 15m) and refresh lifetime (default 30d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# MongoDB (optional - falls back to an in-memory store when unreachable)
# Local dev:  mongodb://127.0.0.1:27017/phidim_service
# Atlas:      mongodb+srv://USERNAME:PASSWORD@clustername.mongodb.net/phidim_service
MONGODB_URI=mongodb://127.0.0.1:27017/phidim_service
